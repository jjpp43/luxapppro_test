# Worker is not deployed yet. Earn stays off until a store flag is flipped.
# Do not register Lightspeed webhooks until a pilot store is chosen.

PORT=8787
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Poll every N minutes. Set 0 to poll only via POST /jobs/poll
POLL_INTERVAL_MINUTES=15
LIGHTSPEED_LOOKBACK_HOURS=48
LIGHTSPEED_SALE_STATES=closed
WORKER_JOB_SECRET=

# Single retailer (Decatur today). Same worker accepts more later.
LIGHTSPEED_DOMAIN=
LIGHTSPEED_PERSONAL_TOKEN=

# Optional: multiple retailers. When set, this replaces the single-domain pair.
# LIGHTSPEED_SOURCES=[{"id":"decatur","domain":"luxbeauty4","token":"..."},{"id":"craig","domain":"...","token":"..."}]

LOYALTY_WEBHOOKS_ENABLED=false
LOYALTY_EARN_GLOBAL=false
LIGHTSPEED_WEBHOOK_SECRET=
