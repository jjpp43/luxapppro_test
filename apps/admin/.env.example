NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new Supabase projects; legacy anon key remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth admin API (server-side only — never NEXT_PUBLIC_).
# Prefer the new sb_secret_ key; legacy service_role remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lightspeed X-Series (server-side only — never NEXT_PUBLIC_)
LIGHTSPEED_DOMAIN=
LIGHTSPEED_PERSONAL_TOKEN=
